# API Server base URL (no trailing slash)
VITE_API_URL=http://localhost:4000

# WebSocket server base URL (same host as API, different path)
VITE_WS_URL=ws://localhost:4000

# HLS stream base URL (served by Nginx)
VITE_HLS_URL=http://localhost/hls

# Media server base URL (for WHIP ingest — used by broadcaster)
VITE_MEDIA_SERVER_URL=http://localhost:3001
